{
  "name": "Rice",
  "appearance": "{{ mode }}",
  "canvas": "{{ background }}",
  "accent": "{{ accent }}",
  "colors": {
    "canvas": "{{ background }}",
    "chrome": "{{ background }}",
    "toolbar": "{{ background }}",
    "toolbarForeground": "{{ ui_text }}",
    "toolbarBorder": "{{ ui_border }}",
    "toolbarControl": "{{ ui_surface }}",
    "toolbarControlForeground": "{{ ui_text }}",
    "toolbarControlHover": "{{ ui_surface_alt }}",

    "surface": "{{ ui_surface }}",
    "surfaceRaised": "{{ ui_surface }}",
    "surfaceOverlay": "{{ ui_surface }}",

    "text": "{{ ui_text }}",
    "textMuted": "{{ ui_dim }}",
    "border": "{{ ui_border }}",
    "input": "{{ mix background foreground 24% }}",
    "focus": "{{ accent }}",
    "accent": "{{ accent }}",
    "accentForeground": "{{ ui_on_accent }}",

    "secondary": "{{ ui_surface }}",
    "secondaryForeground": "{{ ui_text }}",
    "muted": "{{ ui_surface }}",
    "mutedForeground": "{{ ui_dim }}",
    "placeholder": "{{ ui_dim }}",
    "secondaryLabel": "{{ ui_dim }}",
    "iconMuted": "{{ ui_dim }}",

    "error": "{{ red }}",
    "errorForeground": "{{ mix red foreground 35% }}",
    "errorSurface": "{{ mix background red 12% }}",
    "warning": "{{ yellow }}",
    "warningForeground": "{{ mix yellow foreground 55% }}",
    "warningSurface": "{{ mix background yellow 12% }}",
    "update": "{{ accent }}",
    "updateForeground": "{{ mix accent foreground 45% }}",
    "updateSurface": "{{ mix background accent 12% }}",

    "accentSurface": "{{ ui_surface_alt }}",
    "accentSurfaceForeground": "{{ ui_text }}",
    "messageSurface": "{{ ui_surface }}",
    "messageForeground": "{{ ui_text }}",
    "messageAction": "{{ accent }}",
    "messageActionForeground": "{{ ui_on_accent }}",
    "messageActionHover": "{{ mix accent foreground 15% }}",

    "codeBackground": "{{ dark_background }}",
    "codeForeground": "{{ ui_text }}",

    "searchMatchBackground": "{{ mix background yellow 25% }}",
    "searchMatchForeground": "{{ ui_text }}",
    "searchMatchActiveBackground": "{{ mix background orange 35% }}",
    "searchMatchActiveForeground": "{{ ui_text }}",

    "sidebar": "{{ dark_background }}",
    "sidebarForeground": "{{ ui_text }}",
    "sidebarMutedForeground": "{{ ui_dim }}",
    "sidebarBorder": "{{ ui_border }}",
    "sidebarControlSurface": "{{ mix dark_background foreground 6% }}",
    "sidebarRowHover": "{{ mix dark_background foreground 6% }}",
    "sidebarRowActive": "{{ mix dark_background foreground 12% }}",
    "sidebarRowSelected": "{{ mix dark_background foreground 9% }}",

    "terminalBackground": "{{ background }}",
    "terminalForeground": "{{ ui_text }}",
    "terminalCursor": "{{ bright_foreground }}",
    "terminalSelection": "{{ selection }}",
    "terminalScrollbar": "{{ muted }}",
    "terminalScrollbarHover": "{{ dark_foreground }}"
  }
}
